---
source: tests/completions.rs
description: "the completion script of this build; any change to a command, flag, alias, about text or fixed value changes it: re-accept with INSTA_UPDATE=always cargo test --test completions, then review git diff tests/snapshots/"
---

using namespace System.Management.Automation
using namespace System.Management.Automation.Language

Register-ArgumentCompleter -Native -CommandName 'omaddons' -ScriptBlock {
    param($wordToComplete, $commandAst, $cursorPosition)

    $commandElements = $commandAst.CommandElements
    $command = @(
        'omaddons'
        for ($i = 1; $i -lt $commandElements.Count; $i++) {
            $element = $commandElements[$i]
            if ($element -isnot [StringConstantExpressionAst] -or
                $element.StringConstantType -ne [StringConstantType]::BareWord -or
                $element.Value.StartsWith('-') -or
                $element.Value -eq $wordToComplete) {
                break
        }
        $element.Value
    }) -join ';'

    $completions = @(switch ($command) {
        'omaddons' {
            [CompletionResult]::new('--format', '--format', [CompletionResultType]::ParameterName, 'Output format')
            [CompletionResult]::new('-t', '-t', [CompletionResultType]::ParameterName, 'The client to act on: id, key, game mode (sod and hardcore select the Classic Era client), family, product, flavor folder, path, or all (every client)')
            [CompletionResult]::new('--target', '--target', [CompletionResultType]::ParameterName, 'The client to act on: id, key, game mode (sod and hardcore select the Classic Era client), family, product, flavor folder, path, or all (every client)')
            [CompletionResult]::new('--flavor', '--flavor', [CompletionResultType]::ParameterName, 'The client to act on: id, key, game mode (sod and hardcore select the Classic Era client), family, product, flavor folder, path, or all (every client)')
            [CompletionResult]::new('--actor', '--actor', [CompletionResultType]::ParameterName, 'Who is acting: human, agent or widget [env: OMADDONS_ACTOR]')
            [CompletionResult]::new('--reason', '--reason', [CompletionResultType]::ParameterName, 'Why, recorded verbatim in history (at most 200 characters; ignored by commands that change nothing)')
            [CompletionResult]::new('--if-match', '--if-match', [CompletionResultType]::ParameterName, 'Change nothing unless the plan is still the one the --dry-run that returned this token (data.precondition) showed')
            [CompletionResult]::new('--progress', '--progress', [CompletionResultType]::ParameterName, 'Progress events on stderr')
            [CompletionResult]::new('--json', '--json', [CompletionResultType]::ParameterName, 'One JSON envelope on stdout')
            [CompletionResult]::new('--robot', '--robot', [CompletionResultType]::ParameterName, 'The same as --json')
            [CompletionResult]::new('--dry-run', '--dry-run', [CompletionResultType]::ParameterName, 'Show the plan without changing anything (ignored by commands that change nothing)')
            [CompletionResult]::new('--offline', '--offline', [CompletionResultType]::ParameterName, 'Fail any network access [env: OMADDONS_OFFLINE=1]')
            [CompletionResult]::new('--while-running', '--while-running', [CompletionResultType]::ParameterName, 'Allow folder changes while the client runs (never SavedVariables)')
            [CompletionResult]::new('--no-color', '--no-color', [CompletionResultType]::ParameterName, 'No ANSI color')
            [CompletionResult]::new('--no-progress', '--no-progress', [CompletionResultType]::ParameterName, 'No progress output')
            [CompletionResult]::new('--quiet', '--quiet', [CompletionResultType]::ParameterName, 'Only errors on stderr')
            [CompletionResult]::new('-v', '-v', [CompletionResultType]::ParameterName, 'More detail (repeatable)')
            [CompletionResult]::new('--verbose', '--verbose', [CompletionResultType]::ParameterName, 'More detail (repeatable)')
            [CompletionResult]::new('-h', '-h', [CompletionResultType]::ParameterName, 'Show help')
            [CompletionResult]::new('--help', '--help', [CompletionResultType]::ParameterName, 'Show help')
            [CompletionResult]::new('-V', '-V ', [CompletionResultType]::ParameterName, 'Show the version (before any command: `install --version V` pins a release)')
            [CompletionResult]::new('--version', '--version', [CompletionResultType]::ParameterName, 'Show the version (before any command: `install --version V` pins a release)')
            [CompletionResult]::new('help', 'help', [CompletionResultType]::ParameterValue, 'Show help for omaddons or one command')
            [CompletionResult]::new('status', 'status', [CompletionResultType]::ParameterValue, 'Triage: every client, its addons, running state and what needs attention')
            [CompletionResult]::new('install', 'install', [CompletionResultType]::ParameterValue, 'Install or update addons in one target, verified by its own TOC rules')
            [CompletionResult]::new('add', 'add', [CompletionResultType]::ParameterValue, 'Install or update addons in one target, verified by its own TOC rules')
            [CompletionResult]::new('update', 'update', [CompletionResultType]::ParameterValue, 'Update every managed addon on every client, or the ones named (undo with one undo)')
            [CompletionResult]::new('upgrade', 'upgrade', [CompletionResultType]::ParameterValue, 'Update every managed addon on every client, or the ones named (undo with one undo)')
            [CompletionResult]::new('pin', 'pin', [CompletionResultType]::ParameterValue, 'Hold an addon at its release through updates (undoable)')
            [CompletionResult]::new('unpin', 'unpin', [CompletionResultType]::ParameterValue, 'Let a pinned addon update again')
            [CompletionResult]::new('adopt', 'adopt', [CompletionResultType]::ParameterValue, 'Bring addons installed by hand or by other managers under management, as they are (records only, undoable); alone, report where they come from')
            [CompletionResult]::new('sync', 'sync', [CompletionResultType]::ParameterValue, 'Make every client match addons.toml: install what is missing, set pins and channels')
            [CompletionResult]::new('copy', 'copy', [CompletionResultType]::ParameterValue, 'Install one client''s addons on another, where builds exist (undoable)')
            [CompletionResult]::new('remove', 'remove', [CompletionResultType]::ParameterValue, 'Remove managed addons from one target (undoable)')
            [CompletionResult]::new('uninstall', 'uninstall', [CompletionResultType]::ParameterValue, 'Remove managed addons from one target (undoable)')
            [CompletionResult]::new('rm', 'rm', [CompletionResultType]::ParameterValue, 'Remove managed addons from one target (undoable)')
            [CompletionResult]::new('delete', 'delete', [CompletionResultType]::ParameterValue, 'Remove managed addons from one target (undoable)')
            [CompletionResult]::new('undo', 'undo', [CompletionResultType]::ParameterValue, 'Revert the last change (or one by id), SavedVariables included')
            [CompletionResult]::new('revert', 'revert', [CompletionResultType]::ParameterValue, 'Revert the last change (or one by id), SavedVariables included')
            [CompletionResult]::new('rollback', 'rollback', [CompletionResultType]::ParameterValue, 'Revert the last change (or one by id), SavedVariables included')
            [CompletionResult]::new('apply', 'apply', [CompletionResultType]::ParameterValue, 'Run exactly what a --dry-run stored (its plan id), target by target')
            [CompletionResult]::new('backup', 'backup', [CompletionResultType]::ParameterValue, 'Each client''s WTF/ backups: copies of its settings (bare: list them)')
            [CompletionResult]::new('history', 'history', [CompletionResultType]::ParameterValue, 'Show what changed, when, by whom and why')
            [CompletionResult]::new('log', 'log', [CompletionResultType]::ParameterValue, 'Show what changed, when, by whom and why')
            [CompletionResult]::new('plans', 'plans', [CompletionResultType]::ParameterValue, 'Inspect a stored plan and what history records of it (changes nothing)')
            [CompletionResult]::new('outdated', 'outdated', [CompletionResultType]::ParameterValue, 'Which managed addons have updates, on every client (changes nothing)')
            [CompletionResult]::new('check', 'check', [CompletionResultType]::ParameterValue, 'Which managed addons have updates, on every client (changes nothing)')
            [CompletionResult]::new('info', 'info', [CompletionResultType]::ParameterValue, 'What an addon is: installed records, catalog entry and newest release')
            [CompletionResult]::new('show', 'show', [CompletionResultType]::ParameterValue, 'What an addon is: installed records, catalog entry and newest release')
            [CompletionResult]::new('search', 'search', [CompletionResultType]::ParameterValue, 'Find addons by name in the catalog, WoWInterface, Tukui and GitHub')
            [CompletionResult]::new('find', 'find', [CompletionResultType]::ParameterValue, 'Find addons by name in the catalog, WoWInterface, Tukui and GitHub')
            [CompletionResult]::new('errors', 'errors', [CompletionResultType]::ParameterValue, 'Which addon most likely throws Lua errors, how often, and whether an update may fix it (from BugGrabber)')
            [CompletionResult]::new('export', 'export', [CompletionResultType]::ParameterValue, 'Every client''s addon set as one addons.toml for sync (stdout, or --write)')
            [CompletionResult]::new('net-log', 'net-log', [CompletionResultType]::ParameterValue, 'Every network request omaddons made')
            [CompletionResult]::new('list', 'list', [CompletionResultType]::ParameterValue, 'List the addons in each target''s AddOns folder')
            [CompletionResult]::new('ls', 'ls', [CompletionResultType]::ParameterValue, 'List the addons in each target''s AddOns folder')
            [CompletionResult]::new('targets', 'targets', [CompletionResultType]::ParameterValue, 'List the WoW clients, or add, remove, rename and choose them')
            [CompletionResult]::new('config', 'config', [CompletionResultType]::ParameterValue, 'Show or change config.toml')
            [CompletionResult]::new('auth', 'auth', [CompletionResultType]::ParameterValue, 'Store, check or clear the opt-in GitHub token (5,000 REST requests an hour)')
            [CompletionResult]::new('omarchy', 'omarchy', [CompletionResultType]::ParameterValue, 'Put the omaddons widget on Omarchy''s bar')
            [CompletionResult]::new('completions', 'completions', [CompletionResultType]::ParameterValue, 'Print a shell completion script: bash, zsh, fish, elvish or powershell')
            [CompletionResult]::new('robot-docs', 'robot-docs', [CompletionResultType]::ParameterValue, 'Documentation for agents: the guide (bare), the JSON Schemas and the error catalog')
            break
        }
        'omaddons;help' {
            [CompletionResult]::new('--format', '--format', [CompletionResultType]::ParameterName, 'Output format')
            [CompletionResult]::new('-t', '-t', [CompletionResultType]::ParameterName, 'The client to act on: id, key, game mode (sod and hardcore select the Classic Era client), family, product, flavor folder, path, or all (every client)')
            [CompletionResult]::new('--target', '--target', [CompletionResultType]::ParameterName, 'The client to act on: id, key, game mode (sod and hardcore select the Classic Era client), family, product, flavor folder, path, or all (every client)')
            [CompletionResult]::new('--flavor', '--flavor', [CompletionResultType]::ParameterName, 'The client to act on: id, key, game mode (sod and hardcore select the Classic Era client), family, product, flavor folder, path, or all (every client)')
            [CompletionResult]::new('--actor', '--actor', [CompletionResultType]::ParameterName, 'Who is acting: human, agent or widget [env: OMADDONS_ACTOR]')
