---
source: tests/completions.rs
description: "the completion script of this build; any change to a command, flag, alias, about text or fixed value changes it: re-accept with INSTA_UPDATE=always cargo test --test integration completions::, then review git diff tests/snapshots/"
---

use builtin;
use str;

set edit:completion:arg-completer[omaddons] = {|@words|
    fn spaces {|n|
        builtin:repeat $n ' ' | str:join ''
    }
    fn cand {|text desc|
        edit:complex-candidate $text &display=$text' '(spaces (- 14 (wcswidth $text)))$desc
    }
    var command = 'omaddons'
    for word $words[1..-1] {
        if (str:has-prefix $word '-') {
            break
        }
        set command = $command';'$word
    }
    var completions = [
        &'omaddons'= {
            cand --format 'Output format'
            cand -t 'The client to act on: id, game mode, family, path, or all'
            cand --target 'The client to act on: id, game mode, family, path, or all'
            cand --flavor 'The client to act on: id, game mode, family, path, or all'
            cand --actor 'Who is acting: human, agent or widget [env: OMADDONS_ACTOR]'
            cand --reason 'Why, recorded verbatim in history'
            cand --if-match 'Run only what the preview that returned this token showed'
            cand --progress 'Progress events on stderr'
            cand --json 'One JSON envelope on stdout'
            cand --robot 'The same as --json'
            cand --dry-run 'Show the plan without changing anything'
            cand --offline 'Fail any network access [env: OMADDONS_OFFLINE=1]'
            cand --while-running 'Allow folder changes while the client runs (never SavedVariables)'
            cand --no-color 'No ANSI color'
            cand --no-progress 'No progress output'
            cand --quiet 'Only errors on stderr'
            cand -v 'More detail (repeatable)'
            cand --verbose 'More detail (repeatable)'
            cand -h 'Show help'
            cand --help 'Show help'
            cand -V 'Show the version'
            cand --version 'Show the version'
            cand help 'Show help for omaddons or one command'
            cand status 'Triage every client: addons, updates, issues, backups'
            cand install 'Install or update addons on one client'
            cand add 'Install or update addons on one client'
            cand update 'Update managed addons on every client'
            cand upgrade 'Update managed addons on every client'
            cand pin 'Hold an addon at its release through updates'
            cand unpin 'Let a pinned addon update again'
            cand adopt 'Bring addons installed by hand under management'
            cand sync 'Make every client match addons.toml'
            cand copy 'Install one client''s addons on another'
            cand remove 'Remove managed addons from one client'
            cand uninstall 'Remove managed addons from one client'
            cand rm 'Remove managed addons from one client'
            cand delete 'Remove managed addons from one client'
            cand undo 'Revert the last change, or one by its id'
            cand revert 'Revert the last change, or one by its id'
            cand rollback 'Revert the last change, or one by its id'
            cand apply 'Run exactly the plan a --dry-run stored'
            cand backup 'Back up, list and restore each client''s WTF/ settings'
            cand history 'Show what changed, when, by whom and why'
            cand log 'Show what changed, when, by whom and why'
            cand plans 'Inspect a stored plan and whether it was applied'
            cand outdated 'Show which managed addons have updates'
            cand check 'Show which managed addons have updates'
            cand info 'Show what an addon is and where it is installed'
            cand show 'Show what an addon is and where it is installed'
            cand search 'Find addons in the catalog, WoWInterface, Tukui and GitHub'
            cand find 'Find addons in the catalog, WoWInterface, Tukui and GitHub'
            cand errors 'Show which addons throw Lua errors, from BugGrabber'
            cand export 'Print every client''s addon set as one addons.toml'
            cand net-log 'List the network requests and git runs omaddons made'
            cand doctor 'Find what is broken in what omaddons manages'
            cand list 'List the addons in each target''s AddOns folder'
            cand ls 'List the addons in each target''s AddOns folder'
            cand targets 'List the WoW clients, or add, remove, rename and choose them'
            cand config 'Show or change config.toml'
            cand auth 'Store, check or clear the opt-in GitHub token'
            cand omarchy 'Put the omaddons widget on Omarchy''s bar'
            cand completions 'Print a shell completion script'
            cand robot-docs 'Print documentation for agents'
            cand capabilities 'Describe everything this build can do, for agents'
