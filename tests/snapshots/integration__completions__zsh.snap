---
source: tests/completions.rs
description: "the completion script of this build; any change to a command, flag, alias, about text or fixed value changes it: re-accept with INSTA_UPDATE=always cargo test --test integration completions::, then review git diff tests/snapshots/"
---
#compdef omaddons

autoload -U is-at-least

_omaddons() {
    typeset -A opt_args
    typeset -a _arguments_options
    local ret=1

    if is-at-least 5.2; then
        _arguments_options=(-s -S -C)
    else
        _arguments_options=(-s -C)
    fi

    local context curcontext="$curcontext" state line
    _arguments "${_arguments_options[@]}" : \
'--format=[Output format]:FORMAT:(json human)' \
'-t+[The client to act on\: id, game mode, family, path, or all]:TARGET:_default' \
'--target=[The client to act on\: id, game mode, family, path, or all]:TARGET:_default' \
'--flavor=[The client to act on\: id, game mode, family, path, or all]:TARGET:_default' \
'--actor=[Who is acting\: human, agent or widget \[env\: OMADDONS_ACTOR\]]:ACTOR:_default' \
'--reason=[Why, recorded verbatim in history]:TEXT:_default' \
'--if-match=[Run only what the preview that returned this token showed]:TOKEN:_default' \
'--progress=[Progress events on stderr]:MODE:(json human none)' \
'--json[One JSON envelope on stdout]' \
'--robot[The same as --json]' \
'--dry-run[Show the plan without changing anything]' \
'--offline[Fail any network access \[env\: OMADDONS_OFFLINE=1\]]' \
'--while-running[Allow folder changes while the client runs (never SavedVariables)]' \
'--no-color[No ANSI color]' \
'--no-progress[No progress output]' \
'--quiet[Only errors on stderr]' \
'*-v[More detail (repeatable)]' \
'*--verbose[More detail (repeatable)]' \
'-h[Show help]' \
'--help[Show help]' \
'-V[Show the version]' \
'--version[Show the version]' \
":: :_omaddons_commands" \
"*::: :->omaddons" \
&& ret=0
    case $state in
    (omaddons)
        words=($line[1] "${words[@]}")
        (( CURRENT += 1 ))
        curcontext="${curcontext%:*:*}:omaddons-command-$line[1]:"
        case $line[1] in
            (help)
_arguments "${_arguments_options[@]}" : \
'--format=[Output format]:FORMAT:(json human)' \
'-t+[The client to act on\: id, game mode, family, path, or all]:TARGET:_default' \
'--target=[The client to act on\: id, game mode, family, path, or all]:TARGET:_default' \
'--flavor=[The client to act on\: id, game mode, family, path, or all]:TARGET:_default' \
'--actor=[Who is acting\: human, agent or widget \[env\: OMADDONS_ACTOR\]]:ACTOR:_default' \
'--reason=[Why, recorded verbatim in history]:TEXT:_default' \
'--if-match=[Run only what the preview that returned this token showed]:TOKEN:_default' \
'--progress=[Progress events on stderr]:MODE:(json human none)' \
'--json[One JSON envelope on stdout]' \
'--robot[The same as --json]' \
'--dry-run[Show the plan without changing anything]' \
'--offline[Fail any network access \[env\: OMADDONS_OFFLINE=1\]]' \
'--while-running[Allow folder changes while the client runs (never SavedVariables)]' \
'--no-color[No ANSI color]' \
'--no-progress[No progress output]' \
'--quiet[Only errors on stderr]' \
'*-v[More detail (repeatable)]' \
'*--verbose[More detail (repeatable)]' \
'-h[Show help]' \
'--help[Show help]' \
'*::command -- The command to explain; a nested one by its path (`targets add`):_default' \
&& ret=0
;;
(status)
_arguments "${_arguments_options[@]}" : \
'--format=[Output format]:FORMAT:(json human)' \
'-t+[The client to act on\: id, game mode, family, path, or all]:TARGET:_default' \
'--target=[The client to act on\: id, game mode, family, path, or all]:TARGET:_default' \
'--flavor=[The client to act on\: id, game mode, family, path, or all]:TARGET:_default' \
'--actor=[Who is acting\: human, agent or widget \[env\: OMADDONS_ACTOR\]]:ACTOR:_default' \
'--reason=[Why, recorded verbatim in history]:TEXT:_default' \
'--if-match=[Run only what the preview that returned this token showed]:TOKEN:_default' \
'--progress=[Progress events on stderr]:MODE:(json human none)' \
'--cached[Local state only, no scan (fast; the widget'\''s view)]' \
'--check[Exit 6 when anything needs attention]' \
'(--cached)--deep[Re-hash every managed file, not only those whose size or time changed]' \
'--json[One JSON envelope on stdout]' \
'--robot[The same as --json]' \
'--dry-run[Show the plan without changing anything]' \
'--offline[Fail any network access \[env\: OMADDONS_OFFLINE=1\]]' \
'--while-running[Allow folder changes while the client runs (never SavedVariables)]' \
'--no-color[No ANSI color]' \
'--no-progress[No progress output]' \
'--quiet[Only errors on stderr]' \
'*-v[More detail (repeatable)]' \
'*--verbose[More detail (repeatable)]' \
'-h[Show help]' \
'--help[Show help]' \
&& ret=0
;;
(install)
_arguments "${_arguments_options[@]}" : \
'--channel=[The release channel to install from]:CHANNEL:(stable beta alpha)' \
'--version=[Install exactly this release\: a tag for gh\: refs, a rev for git\: refs]:VERSION:_default' \
'--file=[Install this downloaded archive as the release of the one given ref]:ZIP:_files' \
'--format=[Output format]:FORMAT:(json human)' \
'-t+[The client to act on\: id, game mode, family, path, or all]:TARGET:_default' \
'--target=[The client to act on\: id, game mode, family, path, or all]:TARGET:_default' \
'--flavor=[The client to act on\: id, game mode, family, path, or all]:TARGET:_default' \
'--actor=[Who is acting\: human, agent or widget \[env\: OMADDONS_ACTOR\]]:ACTOR:_default' \
'--reason=[Why, recorded verbatim in history]:TEXT:_default' \
'--if-match=[Run only what the preview that returned this token showed]:TOKEN:_default' \
'--progress=[Progress events on stderr]:MODE:(json human none)' \
'--reinstall[Install the recorded release again, replacing its folders]' \
'--no-deps[Install only the named addons, not the ones their TOCs require]' \
'--force[Take over another addon'\''s folder, or replace an unmanaged one]' \
'--strict[Exit 6 when only some of the addons install]' \
'--refresh[Fetch every release from its source, never from remembered metadata]' \
'(--no-any-flavor)--any-flavor[Install builds the publisher did not make for this client]' \
'--no-any-flavor[Clear --any-flavor for these addons on this client]' \
'--json[One JSON envelope on stdout]' \
'--robot[The same as --json]' \
'--dry-run[Show the plan without changing anything]' \
'--offline[Fail any network access \[env\: OMADDONS_OFFLINE=1\]]' \
'--while-running[Allow folder changes while the client runs (never SavedVariables)]' \
'--no-color[No ANSI color]' \
'--no-progress[No progress output]' \
'--quiet[Only errors on stderr]' \
'*-v[More detail (repeatable)]' \
'*--verbose[More detail (repeatable)]' \
'-h[Show help]' \
'--help[Show help]' \
'*::refs -- What to install\: a catalog name, a ref, a link or a local path:_default' \
&& ret=0
;;
(add)
_arguments "${_arguments_options[@]}" : \
