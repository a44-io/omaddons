(( $+functions[_omaddons_commands] )) ||
_omaddons_commands() {
    local commands; commands=(
'help:Show help for omaddons or one command' \
'status:Triage every client\: addons, updates, issues, backups' \
'install:Install or update addons on one client' \
'add:Install or update addons on one client' \
'update:Update managed addons on every client' \
'upgrade:Update managed addons on every client' \
'pin:Hold an addon at its release through updates' \
'unpin:Let a pinned addon update again' \
'adopt:Bring addons installed by hand under management' \
'sync:Make every client match addons.toml' \
'copy:Install one client'\''s addons on another' \
'remove:Remove managed addons from one client' \
'uninstall:Remove managed addons from one client' \
'rm:Remove managed addons from one client' \
'delete:Remove managed addons from one client' \
'undo:Revert the last change, or one by its id' \
'revert:Revert the last change, or one by its id' \
'rollback:Revert the last change, or one by its id' \
'apply:Run exactly the plan a --dry-run stored' \
'backup:Back up, list and restore each client'\''s WTF/ settings' \
'history:Show what changed, when, by whom and why' \
'log:Show what changed, when, by whom and why' \
'plans:Inspect a stored plan and whether it was applied' \
'outdated:Show which managed addons have updates' \
'check:Show which managed addons have updates' \
'info:Show what an addon is and where it is installed' \
'show:Show what an addon is and where it is installed' \
'search:Find addons in the catalog, WoWInterface, Tukui and GitHub' \
'find:Find addons in the catalog, WoWInterface, Tukui and GitHub' \
'errors:Show which addons throw Lua errors, from BugGrabber' \
'export:Print every client'\''s addon set as one addons.toml' \
'net-log:List the network requests and git runs omaddons made' \
'doctor:Find what is broken in what omaddons manages' \
'list:List the addons in each target'\''s AddOns folder' \
'ls:List the addons in each target'\''s AddOns folder' \
'targets:List the WoW clients, or add, remove, rename and choose them' \
'config:Show or change config.toml' \
'auth:Store, check or clear the opt-in GitHub token' \
'omarchy:Put the omaddons widget on Omarchy'\''s bar' \
'completions:Print a shell completion script' \
'robot-docs:Print documentation for agents' \
'capabilities:Describe everything this build can do, for agents' \
    )
    _describe -t commands 'omaddons commands' commands "$@"
}
