---
source: tests/completions.rs
assertion_line: 71
description: "the completion script of this build; any change to a command, flag, alias, about text or fixed value changes it: re-accept with INSTA_UPDATE=always cargo test --test completions, then review git diff tests/snapshots/"
---

use builtin;
use str;

set edit:completion:arg-completer[omaddons] = {|@words|
    fn spaces {|n|
        builtin:repeat $n ' ' | str:join ''
    }
    fn cand {|text desc|
        edit:complex-candidate $text &display=$text' '(spaces (- 14 (wcswidth $text)))$desc
    }
    var command = 'omaddons'
    for word $words[1..-1] {
        if (str:has-prefix $word '-') {
            break
        }
        set command = $command';'$word
    }
    var completions = [
        &'omaddons'= {
            cand --format 'Output format'
            cand -t 'The client to act on: id, key, game mode (sod and hardcore select the Classic Era client), family, product, flavor folder, path, or all (every client)'
            cand --target 'The client to act on: id, key, game mode (sod and hardcore select the Classic Era client), family, product, flavor folder, path, or all (every client)'
            cand --flavor 'The client to act on: id, key, game mode (sod and hardcore select the Classic Era client), family, product, flavor folder, path, or all (every client)'
            cand --actor 'Who is acting: human, agent or widget [env: OMADDONS_ACTOR]'
            cand --reason 'Why, recorded verbatim in history (at most 200 characters; ignored by commands that change nothing)'
            cand --if-match 'Change nothing unless the plan is still the one the --dry-run that returned this token (data.precondition) showed'
            cand --progress 'Progress events on stderr'
            cand --json 'One JSON envelope on stdout'
            cand --robot 'The same as --json'
            cand --dry-run 'Show the plan without changing anything (ignored by commands that change nothing)'
            cand --offline 'Fail any network access [env: OMADDONS_OFFLINE=1]'
            cand --while-running 'Allow folder changes while the client runs (never SavedVariables)'
            cand --no-color 'No ANSI color'
            cand --no-progress 'No progress output'
            cand --quiet 'Only errors on stderr'
            cand -v 'More detail (repeatable)'
            cand --verbose 'More detail (repeatable)'
            cand -h 'Show help'
            cand --help 'Show help'
            cand -V 'Show the version (before any command: `install --version V` pins a release)'
            cand --version 'Show the version (before any command: `install --version V` pins a release)'
            cand help 'Show help for omaddons or one command'
            cand status 'Triage: every client, its addons, running state and what needs attention'
            cand install 'Install or update addons in one target, verified by its own TOC rules'
            cand add 'Install or update addons in one target, verified by its own TOC rules'
            cand update 'Update every managed addon on every client, or the ones named (undo with one undo)'
            cand upgrade 'Update every managed addon on every client, or the ones named (undo with one undo)'
            cand pin 'Hold an addon at its release through updates (undoable)'
            cand unpin 'Let a pinned addon update again'
            cand adopt 'Bring addons installed by hand or by other managers under management, as they are (records only, undoable); alone, report where they come from'
            cand sync 'Make every client match addons.toml: install what is missing, set pins and channels'
            cand copy 'Install one client''s addons on another, where builds exist (undoable)'
            cand remove 'Remove managed addons from one target (undoable)'
            cand uninstall 'Remove managed addons from one target (undoable)'
            cand rm 'Remove managed addons from one target (undoable)'
            cand delete 'Remove managed addons from one target (undoable)'
            cand undo 'Revert the last change (or one by id), SavedVariables included'
            cand revert 'Revert the last change (or one by id), SavedVariables included'
            cand rollback 'Revert the last change (or one by id), SavedVariables included'
            cand apply 'Run exactly what a --dry-run stored (its plan id), target by target'
            cand backup 'Each client''s WTF/ backups: copies of its settings (bare: list them)'
            cand history 'Show what changed, when, by whom and why'
            cand log 'Show what changed, when, by whom and why'
            cand plans 'Inspect a stored plan and what history records of it (changes nothing)'
