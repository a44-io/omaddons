---
source: tests/completions.rs
description: "the completion script of this build; any change to a command, flag, alias, about text or fixed value changes it: re-accept with INSTA_UPDATE=always cargo test --test integration completions::, then review git diff tests/snapshots/"
---
# Print an optspec for argparse to handle cmd's options that are independent of any subcommand.
function __fish_omaddons_global_optspecs
    string join \n json robot format= t/target= dry-run actor= reason= offline while-running if-match= no-color no-progress progress= quiet v/verbose h/help V/version
end

function __fish_omaddons_needs_command
    # Figure out if the current invocation already has a command.
    set -l cmd (commandline -opc)
    set -e cmd[1]
    argparse -s (__fish_omaddons_global_optspecs) -- $cmd 2>/dev/null
    or return
    if set -q argv[1]
        # Also print the command, so this can be used to figure out what it is.
        echo $argv[1]
        return 1
    end
    return 0
end

function __fish_omaddons_using_subcommand
    set -l cmd (__fish_omaddons_needs_command)
    test -z "$cmd"
    and return 1
    contains -- $cmd[1] $argv
end

complete -c omaddons -n "__fish_omaddons_needs_command" -l format -d 'Output format' -r -f -a "json\t''
