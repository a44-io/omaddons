---
source: tests/completions.rs
description: "the completion script of this build; any change to a command, flag, alias, about text or fixed value changes it: re-accept with INSTA_UPDATE=always cargo test --test integration completions::, then review git diff tests/snapshots/"
---
_omaddons() {
    local i cur prev opts cmd
    COMPREPLY=()
    if [[ "${BASH_VERSINFO[0]}" -ge 4 ]]; then
        cur="$2"
    else
        cur="${COMP_WORDS[COMP_CWORD]}"
    fi
    prev="$3"
    cmd=""
    opts=""

    for i in "${COMP_WORDS[@]:0:COMP_CWORD}"
    do
        case "${cmd},${i}" in
            ",$1")
                cmd="omaddons"
                ;;
            omaddons,add)
                cmd="omaddons__subcmd__install"
                ;;
            omaddons,adopt)
                cmd="omaddons__subcmd__adopt"
                ;;
            omaddons,apply)
                cmd="omaddons__subcmd__apply"
                ;;
            omaddons,auth)
                cmd="omaddons__subcmd__auth"
                ;;
            omaddons,backup)
                cmd="omaddons__subcmd__backup"
                ;;
            omaddons,capabilities)
