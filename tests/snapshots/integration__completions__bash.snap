                ;;
            omaddons,help)
                cmd="omaddons__subcmd__help"
                ;;
            omaddons,history)
                cmd="omaddons__subcmd__history"
                ;;
            omaddons,info)
                cmd="omaddons__subcmd__info"
                ;;
            omaddons,install)
                cmd="omaddons__subcmd__install"
                ;;
            omaddons,install-completions)
                cmd="omaddons__subcmd__install__subcmd__completions"
                ;;
            omaddons,list)
                cmd="omaddons__subcmd__list"
                ;;
            omaddons,log)
                cmd="omaddons__subcmd__history"
                ;;
            omaddons,ls)
                cmd="omaddons__subcmd__list"
                ;;
            omaddons,net-log)
