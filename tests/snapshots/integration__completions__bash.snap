    done

    case "${cmd}" in
        omaddons)
            opts="-t -v -h -V --json --robot --format --flavor --target --dry-run --actor --reason --offline --while-running --if-match --no-color --no-progress --progress --quiet --verbose --help --version help status install add update upgrade pin unpin skip unskip adopt sync copy remove uninstall rm delete undo revert rollback apply backup history log plans outdated check info show search find errors export net-log doctor list ls targets config auth omarchy completions install-completions robot-docs capabilities"
