if [[ "${BASH_VERSINFO[0]}" -eq 4 && "${BASH_VERSINFO[1]}" -ge 4 || "${BASH_VERSINFO[0]}" -gt 4 ]]; then
    complete -F _omaddons -o nosort -o bashdefault -o default omaddons
else
    complete -F _omaddons -o bashdefault -o default omaddons
fi

# Values from omaddons' own files, where the script above offers only file names:
# client ids, addon names, and plan, backup, transaction, run, doctor run and
# failure-mode ids. The hidden reader, omaddons __complete, reads them without scanning,
# locking, writing or going online, and prints nothing when it has nothing to offer.
_omaddons_dynamic() {
    local cur="$2"
    local word cmdpath= value_of= target= from= kind= eq= client i n=0 rest=0
    for (( i = 1; i < COMP_CWORD; i++ )); do
        word="${COMP_WORDS[i]}"
        if [[ -n $value_of ]]; then
            [[ $word == "=" ]] && continue
            case $value_of in
                -t|--target|--flavor) target=$word ;;
                --from) from=$word ;;
            esac
            value_of=
            continue
        fi
        if (( ! rest )); then
            case $word in
                --) rest=1; continue ;;
                --*=*)
                    case ${word%%=*} in
                        -t|--target|--flavor) target=${word#*=} ;;
                        --from) from=${word#*=} ;;
                    esac
                    continue ;;
                -t?*) target=${word#-t}; continue ;;
                -*)
                    case $word in
                        --actor|--addon|--before|--budget|--by|--channel|--dir|--file|--flavor|--format|--from|--if-match|--keep|--last-by|--limit|--name|--older-than|--only|--progress|--reason|--ref|--release|--revision|--run|--saved-variables|--section|--severity|--since|--skip|--source|--target|--to|--tx|--version|-t) value_of=$word ;;
                    esac
                    continue ;;
            esac
            case "$cmdpath,$word" in
                ",help") cmdpath="help"; n=0; continue ;;
                ",status") cmdpath="status"; n=0; continue ;;
                ",install"|",add") cmdpath="install"; n=0; continue ;;
                ",update"|",upgrade") cmdpath="update"; n=0; continue ;;
                ",pin") cmdpath="pin"; n=0; continue ;;
                ",unpin") cmdpath="unpin"; n=0; continue ;;
                ",skip") cmdpath="skip"; n=0; continue ;;
                ",unskip") cmdpath="unskip"; n=0; continue ;;
                ",adopt") cmdpath="adopt"; n=0; continue ;;
                ",sync") cmdpath="sync"; n=0; continue ;;
                ",copy") cmdpath="copy"; n=0; continue ;;
                ",remove"|",uninstall"|",rm"|",delete") cmdpath="remove"; n=0; continue ;;
                ",undo"|",revert"|",rollback") cmdpath="undo"; n=0; continue ;;
                ",apply") cmdpath="apply"; n=0; continue ;;
                ",backup") cmdpath="backup"; n=0; continue ;;
                "backup,list") cmdpath="backup list"; n=0; continue ;;
                "backup,create") cmdpath="backup create"; n=0; continue ;;
                "backup,restore") cmdpath="backup restore"; n=0; continue ;;
                "backup,prune") cmdpath="backup prune"; n=0; continue ;;
                "backup,export") cmdpath="backup export"; n=0; continue ;;
                "backup,import") cmdpath="backup import"; n=0; continue ;;
                "backup,verify") cmdpath="backup verify"; n=0; continue ;;
                ",history"|",log") cmdpath="history"; n=0; continue ;;
                ",plans") cmdpath="plans"; n=0; continue ;;
                "plans,show") cmdpath="plans show"; n=0; continue ;;
                ",outdated"|",check") cmdpath="outdated"; n=0; continue ;;
                ",info"|",show") cmdpath="info"; n=0; continue ;;
                ",search"|",find") cmdpath="search"; n=0; continue ;;
                ",errors") cmdpath="errors"; n=0; continue ;;
                "errors,dismiss") cmdpath="errors dismiss"; n=0; continue ;;
                ",export") cmdpath="export"; n=0; continue ;;
                ",net-log") cmdpath="net-log"; n=0; continue ;;
                ",doctor") cmdpath="doctor"; n=0; continue ;;
                "doctor,diagnose") cmdpath="doctor diagnose"; n=0; continue ;;
                "doctor,explain") cmdpath="doctor explain"; n=0; continue ;;
                "doctor,fix") cmdpath="doctor fix"; n=0; continue ;;
                "doctor,diff") cmdpath="doctor diff"; n=0; continue ;;
                "doctor,undo") cmdpath="doctor undo"; n=0; continue ;;
                "doctor,gc") cmdpath="doctor gc"; n=0; continue ;;
                ",list"|",ls") cmdpath="list"; n=0; continue ;;
                ",targets") cmdpath="targets"; n=0; continue ;;
                "targets,add") cmdpath="targets add"; n=0; continue ;;
                "targets,rm") cmdpath="targets rm"; n=0; continue ;;
                "targets,rename") cmdpath="targets rename"; n=0; continue ;;
                "targets,default") cmdpath="targets default"; n=0; continue ;;
                ",config") cmdpath="config"; n=0; continue ;;
                "config,get") cmdpath="config get"; n=0; continue ;;
                "config,set") cmdpath="config set"; n=0; continue ;;
                "config,path") cmdpath="config path"; n=0; continue ;;
                ",auth") cmdpath="auth"; n=0; continue ;;
                "auth,github") cmdpath="auth github"; n=0; continue ;;
                ",omarchy") cmdpath="omarchy"; n=0; continue ;;
                "omarchy,status") cmdpath="omarchy status"; n=0; continue ;;
                "omarchy,install") cmdpath="omarchy install"; n=0; continue ;;
                "omarchy,remove") cmdpath="omarchy remove"; n=0; continue ;;
                ",completions") cmdpath="completions"; n=0; continue ;;
                ",install-completions") cmdpath="install-completions"; n=0; continue ;;
                ",robot-docs") cmdpath="robot-docs"; n=0; continue ;;
                "robot-docs,guide") cmdpath="robot-docs guide"; n=0; continue ;;
                "robot-docs,schema") cmdpath="robot-docs schema"; n=0; continue ;;
                "robot-docs,errors") cmdpath="robot-docs errors"; n=0; continue ;;
                "robot-docs,install-skill") cmdpath="robot-docs install-skill"; n=0; continue ;;
                ",capabilities") cmdpath="capabilities"; n=0; continue ;;
            esac
        fi
        n=$((n + 1))
    done
    [[ $cur == "=" ]] && cur=
    if [[ -z $value_of && $cur == --*=* ]]; then
        value_of=${cur%%=*}
        eq="$value_of="
        cur=${cur#*=}
    fi
    if [[ -n $value_of ]]; then
        case "$cmdpath $value_of" in
            "copy --from") kind=target ;;
            "copy --to") kind=client ;;
            "skip --tx") kind=tx ;;
            "unskip --tx") kind=tx ;;
            "errors --addon") kind=addon ;;
            "backup restore --addon") kind=addon ;;
            "undo --run") kind=run ;;
            "history --run") kind=run ;;
            "doctor --since") kind=doctor-run ;;
            "doctor diagnose --since") kind=doctor-run ;;
            "doctor --only") kind=fm ;;
            "doctor --skip") kind=fm ;;
            "doctor diagnose --only") kind=fm ;;
            "doctor diagnose --skip") kind=fm ;;
            "doctor fix --only") kind=fm ;;
            "doctor fix --skip") kind=fm ;;
            *)
                case $value_of in
                    -t|--target|--flavor) kind=client ;;
                esac ;;
        esac
    elif [[ $cur != -* ]]; then
        case $cmdpath in
            "apply") if (( n == 0 )); then kind=plan; fi ;;
            "backup export") if (( n == 0 )); then kind=backup; fi ;;
            "backup list") if (( n == 0 )); then kind=backup; fi ;;
            "backup prune") if (( n >= 0 )); then kind=backup; fi ;;
            "backup restore") if (( n == 0 )); then kind=backup; fi ;;
            "backup verify") if (( n >= 0 )); then kind=backup; fi ;;
            "copy") if (( n >= 0 )); then kind=addon; fi ;;
            "doctor diff") if (( n == 0 )); then kind=doctor-run; fi ;;
            "doctor explain") if (( n == 0 )); then kind=fm; fi ;;
            "doctor undo") if (( n == 0 )); then kind=doctor-run; fi ;;
            "pin") if (( n == 0 )); then kind=addon; fi ;;
            "plans show") if (( n == 0 )); then kind=plan; fi ;;
            "remove") if (( n >= 0 )); then kind=addon; fi ;;
            "skip") if (( n >= 0 )); then kind=addon; fi ;;
            "targets default") if (( n == 0 )); then kind=client; fi ;;
            "targets rename") if (( n == 0 )); then kind=client; fi ;;
            "targets rm") if (( n == 0 )); then kind=target; fi ;;
            "undo") if (( n == 0 )); then kind=tx; fi ;;
            "unpin") if (( n == 0 )); then kind=addon; fi ;;
            "unskip") if (( n >= 0 )); then kind=addon; fi ;;
            "update") if (( n >= 0 )); then kind=addon; fi ;;
        esac
    fi
    if [[ -n $kind && $cur != [/.~]* ]]; then
        client=$target
        [[ $cmdpath == copy ]] && client=$from
        mapfile -t COMPREPLY < <(omaddons __complete "$kind" ${client:+"--target=$client"} "--prefix=$cur" 2>/dev/null)
        if (( ${#COMPREPLY[@]} )); then
            [[ -n $eq ]] && COMPREPLY=("${COMPREPLY[@]/#/$eq}")
            return 0
        fi
    fi
    _omaddons "$@"
}

if [[ "${BASH_VERSINFO[0]}" -eq 4 && "${BASH_VERSINFO[1]}" -ge 4 || "${BASH_VERSINFO[0]}" -gt 4 ]]; then
    complete -F _omaddons_dynamic -o nosort -o bashdefault -o default omaddons
else
    complete -F _omaddons_dynamic -o bashdefault -o default omaddons
fi
