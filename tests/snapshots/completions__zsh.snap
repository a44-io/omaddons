'restore:Restore the whole WTF/ (keybindings, macros, every addon'\''s settings) from a backup, or with --addon one addon'\''s settings (undoable)' \
'prune:Delete old backups, or the ones named (it cannot be undone)' \
'export:Write a backup to a file off this disk, as a .tar.zst (never replaces a file)' \
'import:Bring back a backup that backup export wrote, as a backup of the client -t names' \
'verify:Check backups against their recorded hashes, or record a first baseline' \
    )
    _describe -t commands 'omaddons backup commands' commands "$@"
