---
source: tests/completions.rs
description: "the completion script of this build; any change to a command, flag, alias, about text or fixed value changes it: re-accept with INSTA_UPDATE=always cargo test --test completions, then review git diff tests/snapshots/"
---
#compdef omaddons

autoload -U is-at-least

_omaddons() {
    typeset -A opt_args
    typeset -a _arguments_options
    local ret=1

    if is-at-least 5.2; then
        _arguments_options=(-s -S -C)
    else
        _arguments_options=(-s -C)
    fi

    local context curcontext="$curcontext" state line
    _arguments "${_arguments_options[@]}" : \
'--format=[Output format]:FORMAT:(json human)' \
'-t+[The client to act on\: id, key, game mode (sod and hardcore select the Classic Era client), family, product, flavor folder, path, or all (every client)]:TARGET:_default' \
'--target=[The client to act on\: id, key, game mode (sod and hardcore select the Classic Era client), family, product, flavor folder, path, or all (every client)]:TARGET:_default' \
'--flavor=[The client to act on\: id, key, game mode (sod and hardcore select the Classic Era client), family, product, flavor folder, path, or all (every client)]:TARGET:_default' \
'--actor=[Who is acting\: human, agent or widget \[env\: OMADDONS_ACTOR\]]:ACTOR:_default' \
'--reason=[Why, recorded verbatim in history (at most 200 characters; ignored by commands that change nothing)]:TEXT:_default' \
'--if-match=[Change nothing unless the plan is still the one the --dry-run that returned this token (data.precondition) showed]:TOKEN:_default' \
'--progress=[Progress events on stderr]:MODE:(json human none)' \
'--json[One JSON envelope on stdout]' \
'--robot[The same as --json]' \
'--dry-run[Show the plan without changing anything (ignored by commands that change nothing)]' \
'--offline[Fail any network access \[env\: OMADDONS_OFFLINE=1\]]' \
'--while-running[Allow folder changes while the client runs (never SavedVariables)]' \
'--no-color[No ANSI color]' \
'--no-progress[No progress output]' \
'--quiet[Only errors on stderr]' \
'*-v[More detail (repeatable)]' \
'*--verbose[More detail (repeatable)]' \
'-h[Show help]' \
'--help[Show help]' \
'-V[Show the version (before any command\: \`install --version V\` pins a release)]' \
'--version[Show the version (before any command\: \`install --version V\` pins a release)]' \
":: :_omaddons_commands" \
"*::: :->omaddons" \
&& ret=0
    case $state in
    (omaddons)
        words=($line[1] "${words[@]}")
        (( CURRENT += 1 ))
        curcontext="${curcontext%:*:*}:omaddons-command-$line[1]:"
        case $line[1] in
            (help)
_arguments "${_arguments_options[@]}" : \
'--format=[Output format]:FORMAT:(json human)' \
'-t+[The client to act on\: id, key, game mode (sod and hardcore select the Classic Era client), family, product, flavor folder, path, or all (every client)]:TARGET:_default' \
'--target=[The client to act on\: id, key, game mode (sod and hardcore select the Classic Era client), family, product, flavor folder, path, or all (every client)]:TARGET:_default' \
'--flavor=[The client to act on\: id, key, game mode (sod and hardcore select the Classic Era client), family, product, flavor folder, path, or all (every client)]:TARGET:_default' \
'--actor=[Who is acting\: human, agent or widget \[env\: OMADDONS_ACTOR\]]:ACTOR:_default' \
'--reason=[Why, recorded verbatim in history (at most 200 characters; ignored by commands that change nothing)]:TEXT:_default' \
'--if-match=[Change nothing unless the plan is still the one the --dry-run that returned this token (data.precondition) showed]:TOKEN:_default' \
'--progress=[Progress events on stderr]:MODE:(json human none)' \
'--json[One JSON envelope on stdout]' \
'--robot[The same as --json]' \
'--dry-run[Show the plan without changing anything (ignored by commands that change nothing)]' \
'--offline[Fail any network access \[env\: OMADDONS_OFFLINE=1\]]' \
'--while-running[Allow folder changes while the client runs (never SavedVariables)]' \
'--no-color[No ANSI color]' \
'--no-progress[No progress output]' \
'--quiet[Only errors on stderr]' \
'*-v[More detail (repeatable)]' \
'*--verbose[More detail (repeatable)]' \
'-h[Show help]' \
'--help[Show help]' \
'*::command -- The command to explain; a nested one by its path (`targets add`):_default' \
&& ret=0
;;
(status)
_arguments "${_arguments_options[@]}" : \
'--format=[Output format]:FORMAT:(json human)' \
'-t+[The client to act on\: id, key, game mode (sod and hardcore select the Classic Era client), family, product, flavor folder, path, or all (every client)]:TARGET:_default' \
'--target=[The client to act on\: id, key, game mode (sod and hardcore select the Classic Era client), family, product, flavor folder, path, or all (every client)]:TARGET:_default' \
'--flavor=[The client to act on\: id, key, game mode (sod and hardcore select the Classic Era client), family, product, flavor folder, path, or all (every client)]:TARGET:_default' \
'--actor=[Who is acting\: human, agent or widget \[env\: OMADDONS_ACTOR\]]:ACTOR:_default' \
'--reason=[Why, recorded verbatim in history (at most 200 characters; ignored by commands that change nothing)]:TEXT:_default' \
'--if-match=[Change nothing unless the plan is still the one the --dry-run that returned this token (data.precondition) showed]:TOKEN:_default' \
'--progress=[Progress events on stderr]:MODE:(json human none)' \
'--cached[Local state only, no scan (fast; the widget'\''s view)]' \
'--check[Exit 6 when anything needs attention]' \
'(--cached)--deep[Re-hash every managed file, not only those whose size or time changed]' \
'--json[One JSON envelope on stdout]' \
'--robot[The same as --json]' \
'--dry-run[Show the plan without changing anything (ignored by commands that change nothing)]' \
'--offline[Fail any network access \[env\: OMADDONS_OFFLINE=1\]]' \
'--while-running[Allow folder changes while the client runs (never SavedVariables)]' \
'--no-color[No ANSI color]' \
'--no-progress[No progress output]' \
'--quiet[Only errors on stderr]' \
'*-v[More detail (repeatable)]' \
'*--verbose[More detail (repeatable)]' \
'-h[Show help]' \
'--help[Show help]' \
&& ret=0
;;
(install)
_arguments "${_arguments_options[@]}" : \
'--channel=[stable, beta or alpha (default\: the addon'\''s recorded channel, then default_channel, then stable)]:CHANNEL:(stable beta alpha)' \
'--version=[Install exactly this release\: a tag for gh\: refs, a rev for git\: refs]:VERSION:_default' \
'--file=[Install this downloaded archive as the release of the one given ref]:ZIP:_files' \
'--format=[Output format]:FORMAT:(json human)' \
