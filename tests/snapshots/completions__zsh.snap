(( $+functions[_omaddons_commands] )) ||
_omaddons_commands() {
    local commands; commands=(
'help:Show help for omaddons or one command' \
'status:Triage\: every client, its addons, running state and what needs attention' \
'install:Install or update addons in one target, verified by its own TOC rules' \
'add:Install or update addons in one target, verified by its own TOC rules' \
'update:Update every managed addon on every client, or the ones named (undo with one undo)' \
'upgrade:Update every managed addon on every client, or the ones named (undo with one undo)' \
'pin:Hold an addon at its release through updates (undoable)' \
'unpin:Let a pinned addon update again' \
'adopt:Bring addons installed by hand or by other managers under management, as they are (records only, undoable); alone, report where they come from' \
'sync:Make every client match addons.toml\: install what is missing, set pins and channels' \
'copy:Install one client'\''s addons on another, where builds exist (undoable)' \
'remove:Remove managed addons from one target (undoable)' \
'uninstall:Remove managed addons from one target (undoable)' \
'rm:Remove managed addons from one target (undoable)' \
'delete:Remove managed addons from one target (undoable)' \
'undo:Revert the last change (or one by id), SavedVariables included' \
'revert:Revert the last change (or one by id), SavedVariables included' \
'rollback:Revert the last change (or one by id), SavedVariables included' \
'backup:Each client'\''s WTF/ backups\: copies of its settings (bare\: list them)' \
'history:Show what changed, when, by whom and why' \
'log:Show what changed, when, by whom and why' \
'outdated:Which managed addons have updates, on every client (changes nothing)' \
'check:Which managed addons have updates, on every client (changes nothing)' \
'info:What an addon is\: installed records, catalog entry and newest release' \
'show:What an addon is\: installed records, catalog entry and newest release' \
'search:Find addons by name in the catalog, WoWInterface, Tukui and GitHub' \
'find:Find addons by name in the catalog, WoWInterface, Tukui and GitHub' \
'errors:Which addon most likely throws Lua errors, how often, and whether an update may fix it (from BugGrabber)' \
'export:Every client'\''s addon set as one addons.toml for sync (stdout, or --write)' \
'net-log:Every network request omaddons made' \
'list:List the addons in each target'\''s AddOns folder' \
'ls:List the addons in each target'\''s AddOns folder' \
'targets:List the WoW clients, or add, remove, rename and choose them' \
'config:Show or change config.toml' \
'auth:Store, check or clear the opt-in GitHub token (5,000 REST requests an hour)' \
'omarchy:Put the omaddons widget on Omarchy'\''s bar' \
'completions:Print a shell completion script\: bash, zsh, fish, elvish or powershell' \
'robot-docs:Documentation for programs and agents\: the JSON Schema of every output, and the error catalog' \
    )
    _describe -t commands 'omaddons commands' commands "$@"
}
