---
source: tests/completions.rs
description: "the completion script of this build; any change to a command, flag, alias, about text or fixed value changes it: re-accept with INSTA_UPDATE=always cargo test --test integration completions::, then review git diff tests/snapshots/"
---

using namespace System.Management.Automation
using namespace System.Management.Automation.Language

Register-ArgumentCompleter -Native -CommandName 'omaddons' -ScriptBlock {
    param($wordToComplete, $commandAst, $cursorPosition)

    $commandElements = $commandAst.CommandElements
    $command = @(
        'omaddons'
        for ($i = 1; $i -lt $commandElements.Count; $i++) {
            $element = $commandElements[$i]
            if ($element -isnot [StringConstantExpressionAst] -or
                $element.StringConstantType -ne [StringConstantType]::BareWord -or
                $element.Value.StartsWith('-') -or
                $element.Value -eq $wordToComplete) {
                break
        }
        $element.Value
    }) -join ';'

    $completions = @(switch ($command) {
        'omaddons' {
            [CompletionResult]::new('--format', '--format', [CompletionResultType]::ParameterName, 'Output format')
            [CompletionResult]::new('-t', '-t', [CompletionResultType]::ParameterName, 'The client to act on: id, game mode, family, path, or all')
            [CompletionResult]::new('--target', '--target', [CompletionResultType]::ParameterName, 'The client to act on: id, game mode, family, path, or all')
            [CompletionResult]::new('--flavor', '--flavor', [CompletionResultType]::ParameterName, 'The client to act on: id, game mode, family, path, or all')
            [CompletionResult]::new('--actor', '--actor', [CompletionResultType]::ParameterName, 'Who is acting: human, agent or widget [env: OMADDONS_ACTOR]')
            [CompletionResult]::new('--reason', '--reason', [CompletionResultType]::ParameterName, 'Why, recorded verbatim in history')
            [CompletionResult]::new('--if-match', '--if-match', [CompletionResultType]::ParameterName, 'Run only what the preview that returned this token showed')
            [CompletionResult]::new('--progress', '--progress', [CompletionResultType]::ParameterName, 'Progress events on stderr')
            [CompletionResult]::new('--json', '--json', [CompletionResultType]::ParameterName, 'One JSON envelope on stdout')
            [CompletionResult]::new('--robot', '--robot', [CompletionResultType]::ParameterName, 'The same as --json')
            [CompletionResult]::new('--dry-run', '--dry-run', [CompletionResultType]::ParameterName, 'Show the plan without changing anything')
            [CompletionResult]::new('--offline', '--offline', [CompletionResultType]::ParameterName, 'Fail any network access [env: OMADDONS_OFFLINE=1]')
            [CompletionResult]::new('--while-running', '--while-running', [CompletionResultType]::ParameterName, 'Allow folder changes while the client runs (never SavedVariables)')
            [CompletionResult]::new('--no-color', '--no-color', [CompletionResultType]::ParameterName, 'No ANSI color')
            [CompletionResult]::new('--no-progress', '--no-progress', [CompletionResultType]::ParameterName, 'No progress output')
            [CompletionResult]::new('--quiet', '--quiet', [CompletionResultType]::ParameterName, 'Only errors on stderr')
            [CompletionResult]::new('-v', '-v', [CompletionResultType]::ParameterName, 'More detail (repeatable)')
            [CompletionResult]::new('--verbose', '--verbose', [CompletionResultType]::ParameterName, 'More detail (repeatable)')
            [CompletionResult]::new('-h', '-h', [CompletionResultType]::ParameterName, 'Show help')
            [CompletionResult]::new('--help', '--help', [CompletionResultType]::ParameterName, 'Show help')
            [CompletionResult]::new('-V', '-V ', [CompletionResultType]::ParameterName, 'Show the version')
            [CompletionResult]::new('--version', '--version', [CompletionResultType]::ParameterName, 'Show the version')
            [CompletionResult]::new('help', 'help', [CompletionResultType]::ParameterValue, 'Show help for omaddons or one command')
            [CompletionResult]::new('status', 'status', [CompletionResultType]::ParameterValue, 'Triage every client: addons, updates, issues, backups')
            [CompletionResult]::new('install', 'install', [CompletionResultType]::ParameterValue, 'Install or update addons on one client')
            [CompletionResult]::new('add', 'add', [CompletionResultType]::ParameterValue, 'Install or update addons on one client')
            [CompletionResult]::new('update', 'update', [CompletionResultType]::ParameterValue, 'Update managed addons on every client')
            [CompletionResult]::new('upgrade', 'upgrade', [CompletionResultType]::ParameterValue, 'Update managed addons on every client')
            [CompletionResult]::new('pin', 'pin', [CompletionResultType]::ParameterValue, 'Hold an addon at its release through updates')
            [CompletionResult]::new('unpin', 'unpin', [CompletionResultType]::ParameterValue, 'Let a pinned addon update again')
            [CompletionResult]::new('skip', 'skip', [CompletionResultType]::ParameterValue, 'Pass over one release; updates resume at the next')
            [CompletionResult]::new('unskip', 'unskip', [CompletionResultType]::ParameterValue, 'Offer a skipped release again')
            [CompletionResult]::new('adopt', 'adopt', [CompletionResultType]::ParameterValue, 'Bring addons installed by hand under management')
            [CompletionResult]::new('sync', 'sync', [CompletionResultType]::ParameterValue, 'Make every client match addons.toml')
            [CompletionResult]::new('copy', 'copy', [CompletionResultType]::ParameterValue, 'Install one client''s addons on another')
            [CompletionResult]::new('remove', 'remove', [CompletionResultType]::ParameterValue, 'Remove managed addons from one client')
            [CompletionResult]::new('uninstall', 'uninstall', [CompletionResultType]::ParameterValue, 'Remove managed addons from one client')
