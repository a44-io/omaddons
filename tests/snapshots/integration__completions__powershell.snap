            [CompletionResult]::new('omarchy', 'omarchy', [CompletionResultType]::ParameterValue, 'Put the omaddons widget on Omarchy''s bar')
            [CompletionResult]::new('completions', 'completions', [CompletionResultType]::ParameterValue, 'Print a shell completion script')
            [CompletionResult]::new('install-completions', 'install-completions', [CompletionResultType]::ParameterValue, 'Install the completion script where your shell looks for it')
            [CompletionResult]::new('robot-docs', 'robot-docs', [CompletionResultType]::ParameterValue, 'Print documentation for agents')
            [CompletionResult]::new('capabilities', 'capabilities', [CompletionResultType]::ParameterValue, 'Describe everything this build can do, for agents')
            break
