            [CompletionResult]::new('search', 'search', [CompletionResultType]::ParameterValue, 'Find addons in the catalog, WoWInterface, Tukui and GitHub')
            [CompletionResult]::new('find', 'find', [CompletionResultType]::ParameterValue, 'Find addons in the catalog, WoWInterface, Tukui and GitHub')
            [CompletionResult]::new('errors', 'errors', [CompletionResultType]::ParameterValue, 'Show which addons throw Lua errors, from BugGrabber')
            [CompletionResult]::new('export', 'export', [CompletionResultType]::ParameterValue, 'Print every client''s addon set as one addons.toml')
            [CompletionResult]::new('net-log', 'net-log', [CompletionResultType]::ParameterValue, 'List the network requests and git runs omaddons made')
            [CompletionResult]::new('doctor', 'doctor', [CompletionResultType]::ParameterValue, 'Find what is broken in what omaddons manages')
            [CompletionResult]::new('list', 'list', [CompletionResultType]::ParameterValue, 'List the addons in each target''s AddOns folder')
            [CompletionResult]::new('ls', 'ls', [CompletionResultType]::ParameterValue, 'List the addons in each target''s AddOns folder')
