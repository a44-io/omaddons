    {
      "name": "BACKOFF_MAX",
      "value": {
        "millis": 8000
      },
      "unit": "ms",
      "config_key": null,
      "notes": "Largest backoff step"
    },
    {
      "name": "RETRY_AFTER_CAP",
      "value": {
        "millis": 60000
      },
      "unit": "ms",
      "config_key": null,
      "notes": "A longer Retry-After fails with rate_limited and the reset time"
    },
    {
      "name": "SOURCE_RECHECK_MIN_INTERVAL",
      "value": {
        "millis": 900000
      },
      "unit": "ms",
      "config_key": null,
      "notes": "outdated reuses the last per-source result inside the window unless --refresh"
